<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0714">
<title>لوحة أدمن ساعي | Saay Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&family=Reem+Kufi:wght@500;700&family=Poppins:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0b0714; --txt:#f5f2ff; --mute:#a9a2c4; --acc:#a855f7; --acc2:#7c3aed; --red:#ff5a7a; --gold:#e8c27a; --green:#22c55e;
  --glass:rgba(255,255,255,.07); --glass2:rgba(255,255,255,.12); --line:rgba(255,255,255,.16);
  --ease:cubic-bezier(.32,.72,0,1); --spring:cubic-bezier(.34,1.56,.64,1);
  --safe-b:env(safe-area-inset-bottom,0px); --safe-t:env(safe-area-inset-top,0px);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{background:var(--bg);color:var(--txt);font-family:'Tajawal',system-ui,sans-serif;min-height:100vh;overflow-x:hidden;padding-bottom:calc(100px + var(--safe-b))}
body.lock{overflow:hidden}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
input,select,textarea{font:inherit;color:inherit}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
svg.i{width:1.25em;height:1.25em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* animated aurora background */
.aurora{position:fixed;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(120% 80% at 50% 0%,#1a0f33 0%,var(--bg) 60%)}
.aurora i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;filter:blur(70px);opacity:.55;animation:float 18s ease-in-out infinite alternate}
.aurora i:nth-child(1){background:#7c3aed;top:-20vmax;right:-15vmax}
.aurora i:nth-child(2){background:#ec4899;bottom:-25vmax;left:-20vmax;animation-duration:24s;opacity:.35}
.aurora i:nth-child(3){background:#2563eb;top:35%;left:20%;width:40vmax;height:40vmax;animation-duration:30s;opacity:.3}
@keyframes float{to{transform:translate3d(8vmax,6vmax,0) scale(1.15) rotate(30deg)}}

/* liquid glass */
.glass{position:relative;background:linear-gradient(135deg,rgba(255,255,255,.13),rgba(255,255,255,.04));
  -webkit-backdrop-filter:blur(26px) saturate(190%);backdrop-filter:blur(26px) saturate(190%);
  border:1px solid var(--line);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset 0 -1px 0 rgba(255,255,255,.06),inset 0 0 22px rgba(255,255,255,.05),0 10px 34px rgba(0,0,0,.4);
  overflow:hidden}
.glass::before{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;
  background:radial-gradient(180px circle at var(--mx,30%) var(--my,0%),rgba(255,255,255,.28),transparent 60%);opacity:.5}

/* header & logo */
header{position:sticky;top:10px;z-index:30;margin:10px 12px 0;border-radius:26px;display:flex;align-items:center;justify-content:space-between;padding:12px 18px}
.logo{font-family:'Reem Kufi',serif;font-size:30px;font-weight:700;line-height:1;background:linear-gradient(120deg,#fff,var(--gold),#fff);background-size:200%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 6s linear infinite;display:flex;flex-direction:column;align-items:center}
.logo small{font-family:'Poppins';font-size:8px;letter-spacing:4px;color:var(--mute);-webkit-text-fill-color:var(--mute);margin-top:2px}
@keyframes shine{to{background-position:200% 0}}
.admin-title{font-weight:800;font-size:15px;color:var(--gold);display:flex;align-items:center;gap:6px}
.ic-btn{position:relative;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;transition:transform .3s var(--spring)}
.ic-btn:active{transform:scale(.85)}

main{max-width:760px;margin:0 auto;padding:16px 14px}
.view{animation:enter .5s var(--ease) both}
@keyframes enter{from{opacity:0;transform:translateY(20px) scale(.98)}}

/* stats */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:20px}
.stat{padding:14px 10px;border-radius:22px;text-align:center}
.stat b{display:block;font:700 20px 'Poppins';color:var(--gold);margin-bottom:2px}
.stat span{font-size:12px;color:var(--mute);font-weight:700}

/* form & inputs */
.card-box{padding:20px;border-radius:28px;margin-bottom:20px}
.sec-h{font-size:20px;font-weight:800;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between}
label{display:block;margin:14px 0 6px;font-weight:700;font-size:13px;color:#e7defc}
.fi{display:flex;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.06);overflow:hidden;transition:.3s}
.fi:focus-within{border-color:var(--acc);box-shadow:0 0 0 4px rgba(168,85,247,.25);background:rgba(255,255,255,.1)}
.fi .ico{width:46px;display:grid;place-items:center;background:var(--glass2);color:var(--mute)}
.fi input,.fi select,.fi textarea{flex:1;min-width:0;background:none;border:0;outline:0;padding:12px 14px;font-size:14px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}

/* images preview */
.imgs{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.imgs .img-item{position:relative;width:76px;aspect-ratio:3/4;border-radius:14px;overflow:hidden;border:1px solid var(--line)}
.imgs .img-item img{width:100%;height:100%;object-fit:cover}
.imgs .img-item button{position:absolute;top:4px;inset-inline-end:4px;width:24px;height:24px;border-radius:50%;background:rgba(255,90,122,.9);color:#fff;font-size:12px;display:grid;place-items:center}
.file-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;border-radius:16px;border:1px dashed var(--acc);background:rgba(168,85,247,.1);margin-top:10px;font-size:13px;font-weight:700;cursor:pointer}

/* buttons */
.btn{position:relative;overflow:hidden;width:100%;padding:14px;border-radius:26px;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:16px;transition:transform .3s var(--spring)}
.btn:active{transform:scale(.96)}
.btn.p{background:linear-gradient(135deg,var(--acc2),var(--acc));box-shadow:0 10px 26px rgba(124,58,237,.5)}
.btn.g{background:var(--glass2);border:1px solid var(--line)}
.btn.wa{background:linear-gradient(135deg,#16a34a,#22c55e);box-shadow:0 8px 20px rgba(34,197,94,.35);margin-top:10px;padding:10px;font-size:13px}

/* product rows */
.prod-row{display:flex;align-items:center;gap:12px;padding:12px;border-radius:22px;margin-bottom:12px}
.prod-row img{width:58px;aspect-ratio:3/4;border-radius:14px;object-fit:cover;background:#1b1230;flex:none}
.prod-info{flex:1;min-width:0}
.prod-info b{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.prod-info small{color:var(--gold);font:600 13px 'Poppins'}
.prod-acts{display:flex;gap:6px}
.act-btn{width:38px;height:38px;border-radius:14px;display:grid;place-items:center;background:var(--glass2);border:1px solid var(--line)}
.act-btn.edit{color:var(--gold)}
.act-btn.del{color:var(--red)}

/* orders */
.ord-card{padding:16px;border-radius:24px;margin-bottom:14px;font-size:14px;line-height:1.8}
.ord-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:8px}
.ord-id{font:700 14px 'Poppins';color:var(--gold)}
.ord-items{background:rgba(0,0,0,.25);padding:10px 12px;border-radius:14px;margin:8px 0;font-size:13px}

/* bottom nav */
.nav{position:fixed;bottom:calc(14px + var(--safe-b));left:50%;transform:translateX(-50%);z-index:40;width:min(94vw,440px);border-radius:34px;display:flex;padding:7px}
.nav button{flex:1;position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 0 7px;font-size:11px;font-weight:700;color:var(--mute);transition:color .3s}
.nav button.on{color:#fff}
.nav .pill{position:absolute;top:7px;bottom:7px;width:calc(33.33% - 4.6px);border-radius:28px;background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.08));box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 4px 16px rgba(168,85,247,.35);transition:transform .5s var(--spring);inset-inline-start:7px}

/* sheet for editing */
.ov{position:fixed;inset:0;z-index:60;background:rgba(5,2,12,.65);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);opacity:0;pointer-events:none;transition:opacity .35s}
.ov.show{opacity:1;pointer-events:auto}
.sheet{position:fixed;z-index:61;bottom:0;left:50%;width:min(100%,560px);max-height:92vh;overflow-y:auto;border-radius:34px 34px 0 0;padding:16px 18px calc(28px + var(--safe-b));transform:translate(-50%,105%);transition:transform .55s var(--ease);background:linear-gradient(160deg,rgba(40,24,72,.92),rgba(14,8,28,.96))}
.sheet.show{transform:translate(-50%,0)}
.grab{width:42px;height:5px;border-radius:5px;background:var(--line);margin:0 auto 14px}

.toast{position:fixed;top:calc(16px + var(--safe-t));left:50%;transform:translate(-50%,-140%);z-index:90;padding:12px 22px;border-radius:30px;font-weight:700;font-size:14px;transition:transform .5s var(--spring);white-space:nowrap}
.toast.show{transform:translate(-50%,0)}
.empty{text-align:center;padding:30px;color:var(--mute);font-size:14px}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute"><defs>
<symbol id="box" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></symbol>
<symbol id="bag" viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></symbol>
