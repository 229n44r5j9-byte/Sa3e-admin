</defs></svg>

<div class="aurora"><i></i><i></i><i></i></div>

<header class="glass">
  <div class="admin-title">لوحة أدمن ساعي</div>
  <div class="logo">سعي<small>SAAY</small></div>
  <button class="ic-btn glass" id="reloadBtn" title="تحديث البيانات"><svg class="i"><use href="#refresh"/></svg></button>
</header>

<main id="app"></main>

<nav class="nav glass" id="bottomNav" style="display:none">
  <span class="pill" id="pill"></span>
  <button data-tab="0" class="on"><svg class="i"><use href="#box"/></svg>المنتجات</button>
  <button data-tab="1"><svg class="i"><use href="#bag"/></svg>الطلبات</button>
  <button data-tab="2"><svg class="i"><use href="#set"/></svg>إعدادات الموقع</button>
</nav>

<div class="ov" id="ov"></div>
<div class="sheet glass" id="sheet"></div>
<div class="toast glass" id="toast"></div>

<script>
const DB = "https://elsho3l-default-rtdb.firebaseio.com";
const WHATSAPP = "201203835674";
const ADMIN_PIN = "1234"; // غير الرقم السري براحتك
const DEF = {marquee:"خصومات آخر الصيف لفترة محدودة",heroTitle:"أناقة تبدأ من <em>راحتك</em>",heroSub:"تشكيلة مختارة بعناية — توصيل لكل المحافظات",shipping:60,hero:"",reviews:[]};

const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const ic = n => `<svg class="i"><use href="#${n}"/></svg>`;
const fmt = n => "LE " + Number(n||0).toLocaleString("en");
const ph = (t="سعي") => "data:image/svg+xml;utf8," + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 400'><rect width='300' height='400' fill='#2a1c4a'/><text x='150' y='205' fill='white' font-size='22' text-anchor='middle' font-family='sans-serif'>${t}</text></svg>`);

async function api(path, method="GET", body){
  const r = await fetch(`${DB}/${path}.json`, {method, headers:{"Content-Type":"application/json"}, body: body===undefined?undefined:JSON.stringify(body)});
  if(!r.ok) throw new Error(r.status);
  return r.json();
}
function toast(t){const e=$("#toast");e.textContent=t;e.classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove("show"),2500)}
function resize(file, max=900){
  return new Promise(res=>{
    const r=new FileReader();
    r.onload=()=>{
      const im=new Image();
      im.onload=()=>{
        const k=Math.min(1,max/Math.max(im.width,im.height)), c=document.createElement("canvas");
        c.width=im.width*k; c.height=im.height*k;
        c.getContext("2d").drawImage(im,0,0,c.width,c.height);
        res(c.toDataURL("image/jpeg",.82));
      };
      im.src=r.result;
    };
    r.readAsDataURL(file);
  });
}

let products = [], orders = [], settings = {...DEF}, curTab = 0;
let newImgs = [];

async function loadAll(){
  try{
    const [p, s, o] = await Promise.all([api("products"), api("settings"), api("orders")]);
    products = p ? Object.entries(p).map(([id,v])=>({id, images:[], sizes:[], ...v})) : [];
    settings = s ? {...DEF, ...s, reviews: s.reviews ? Object.values(s.reviews) : []} : {...DEF};
    orders = o ? Object.entries(o).map(([id,v])=>({id, ...v})).reverse() : [];
    renderTab();
  }catch(e){
    toast("تأكد من الاتصال بالإنترنت وقواعد Firebase");
  }
}

/* بوابة الدخول */
function checkAuth(){
  if(sessionStorage.getItem("saay_admin_logged") === "1"){
    $("#bottomNav").style.display = "flex";
    loadAll();
    return;
  }
  $("#app").innerHTML = `
  <div class="view" style="max-width:400px;margin:40px auto">
    <div class="card-box glass" style="text-align:center">
      <div style="width:60px;height:60px;border-radius:50%;background:var(--glass2);display:grid;place-items:center;margin:0 auto 14px;color:var(--gold)">${ic("lock")}</div>
      <h2 style="margin-bottom:6px">لوحة أدمن ساعي</h2>
      <p style="color:var(--mute);font-size:13px;margin-bottom:18px">أدخل رمز المرور للتحكم الكامل في المتجر</p>
      <div class="fi"><input id="pinIn" type="password" inputmode="numeric" placeholder="الرقم السري" style="text-align:center;font-size:18px;letter-spacing:4px"></div>
      <button class="btn p" id="loginBtn">دخول للوحة التحكم</button>
    </div>
  </div>`;
  $("#loginBtn").onclick = () => {
    if($("#pinIn").value === ADMIN_PIN){
      sessionStorage.setItem("saay_admin_logged", "1");
      $("#bottomNav").style.display = "flex";
      loadAll();
    } else toast("الرقم السري غير صحيح");
  };
}

/* التبويبات */
document.querySelectorAll("#bottomNav button").forEach(b => {
  b.onclick = () => {
    curTab = +b.dataset.tab;
    document.querySelectorAll("#bottomNav button").forEach(x => x.classList.toggle("on", +x.dataset.tab === curTab));
    $("#pill").style.transform = `translateX(${-curTab * 100}%)`;
    renderTab();
  };
});
$("#reloadBtn").onclick = () => { toast("جاري التحديث..."); loadAll(); };

function renderTab(){
  const app = $("#app");
  const statsHtml = `
  <div class="stats">
    <div class="stat glass"><b>${products.length}</b><span>المنتجات</span></div>
    <div class="stat glass"><b>${orders.length}</b><span>الطلبات</span></div>
    <div class="stat glass"><b>${fmt(settings.shipping)}</b><span>الشحن</span></div>
  </div>`;

  if(curTab === 0){
    /* تبويب المنتجات */
    app.innerHTML = `<div class="view">
      ${statsHtml}
      <div class="sec-h">
        <span>إدارة المنتجات (${products.length})</span>
        <button class="btn p" style="width:auto;margin:0;padding:8px 16px;font-size:13px" onclick="openProductModal()">${ic("plus")} منتج جديد</button>
      </div>
      ${products.length ? products.map(p => `
        <div class="prod-row glass">
          <img src="${esc(p.images?.[0] || ph())}" alt="">
          <div class="prod-info">
            <b>${esc(p.name)}</b>
            <small>${fmt(p.price)} ${p.oldPrice>p.price ? `<s style="color:var(--mute)">${fmt(p.oldPrice)}</s>` : ""} • مخزون: ${p.stock}</small>
          </div>
          <div class="prod-acts">
            <button class="act-btn edit" onclick="openProductModal('${esc(p.id)}')" title="تعديل الاسم والصور">${ic("edit")}</button>
            <button class="act-btn del" onclick="delProduct('${esc(p.id)}')" title="حذف">${ic("trash")}</button>
          </div>
        </div>
      `).join("") : `<div class="empty glass" style="border-radius:24px">لا توجد منتجات مضافة بعد.<br>اضغط على <b>"منتج جديد"</b> لإضافة أول منتج.</div>`}
    </div>`;
  } else if(curTab === 1){
    /* تبويب الطلبات */
    app.innerHTML = `<div class="view">
      ${statsHtml}
      <div class="sec-h"><span>الطلبات الواردة (${orders.length})</span></div>
      ${orders.length ? orders.map(o => {
        const itemsText = (o.items||[]).map(i => `• ${i.name} ${i.size?`(${i.size})`:""} × ${i.qty} = ${i.price*i.qty} ج`).join("\n");
        const waText = encodeURIComponent(`أهلاً ${o.name}، بخصوص طلبك من متجر سعي #${o.id.slice(-6).toUpperCase()}:\n${itemsText}\nالإجمالي: ${o.total} جنيه\nالعنوان: ${o.gov} - ${o.address}`);
        return `
        <div class="ord-card glass">
          <div class="ord-top">
            <span class="ord-id">#${o.id.slice(-6).toUpperCase()}</span>
            <span style="font-size:12px;color:var(--mute)">${o.createdAt ? new Date(o.createdAt).toLocaleString("ar-EG") : ""}</span>
          </div>
          <div><b>العميل:</b> ${esc(o.name)} — <a href="tel:${esc(o.phone)}" dir="ltr" style="color:var(--gold)">${esc(o.phone)}</a></div>
          <div><b>العنوان:</b> ${esc(o.gov)} - ${esc(o.address)}</div>
          ${o.note ? `<div><b>ملاحظة:</b> ${esc(o.note)}</div>` : ""}
          <div class="ord-items">
            ${(o.items||[]).map(i => `<div>• ${esc(i.name)} ${i.size?`(${esc(i.size)})`:""} × <b>${i.qty}</b></div>`).join("")}
            <div style="margin-top:6px;border-top:1px solid var(--line);padding-top:6px;color:var(--gold);font-weight:800">الإجمالي شامل الشحن: ${fmt(o.total)}</div>
          </div>
          <div style="display:flex;gap:8px">
            <a href="https://wa.me/2${esc(o.phone.replace(/^0+/,""))}?text=${waText}" target="_blank" class="btn wa" style="flex:1">${ic("wa")} مراسلة العميل واتساب</a>
            <button class="btn g" style="width:auto;margin-top:10px;padding:10px 14px;color:var(--red)" onclick="delOrder('${esc(o.id)}')">${ic("trash")}</button>
          </div>
        </div>`;
      }).join("") : `<div class="empty glass" style="border-radius:24px">لا توجد طلبات حتى الآن</div>`}
    </div>`;
  } else {
    /* تبويب إعدادات الموقع */
    let admHero = settings.hero || "";
    let admRev = [...(settings.reviews || [])];
    app.innerHTML = `<div class="view">
      <div class="card-box glass">
        <div class="sec-h"><span>إعدادات واجهة متجر سعي</span></div>
        <label>نص الشريط المتحرك العلوي</label>
        <div class="fi"><input id="sMarq" value="${esc(settings.marquee)}"></div>
        <label>عنوان الغلاف الرئيسي (يدعم &lt;em&gt; للون الذهبي)</label>
        <div class="fi"><input id="sTitle" value="${esc(settings.heroTitle)}"></div>
        <label>الوصف الفرعي للغلاف</label>
        <div class="fi"><input id="sSub" value="${esc(settings.heroSub)}"></div>
        <label>سعر الشحن الموحد (جنيه)</label>
        <div class="fi"><input id="sShip" type="number" value="${esc(settings.shipping)}"></div>
        
        <label>صورة الغلاف الرئيسية (Hero)</label>
        <label class="file-btn">${ic("img")} اختر صورة الغلاف من جهازك<input type="file" id="sHeroFile" accept="image/*" hidden></label>
        ${admHero ? `<div class="imgs"><div class="img-item" style="width:120px;aspect-ratio:16/9"><img src="${esc(admHero)}"></div></div>` : ""}

        <label>صور آراء العملاء (Reviews)</label>
        <label class="file-btn">${ic("img")} إضافة صور آراء العملاء<input type="file" id="sRevFile" accept="image/*" multiple hidden></label>
        <div class="imgs" id="revPreview"></div>

        <button class="btn p" id="saveSetBtn">حفظ التعديلات على الموقع</button>
      </div>
    </div>`;

    const drawRevs = () => {
      $("#revPreview").innerHTML = admRev.map((u,i) => `<div class="img-item"><img src="${esc(u)}"><button onclick="removeRev(${i})">✕</button></div>`).join("");
    };
    window.removeRev = i => { admRev.splice(i,1); drawRevs(); };
    drawRevs();

    $("#sHeroFile").onchange = async e => {
      if(e.target.files[0]){ admHero = await resize(e.target.files[0], 1200); toast("تم تجهيز صورة الغلاف ✓"); }
    };
    $("#sRevFile").onchange = async e => {
      for(const f of e.target.files) admRev.push(await resize(f, 700));
      drawRevs();
    };
    $("#saveSetBtn").onclick = async () => {
      try{
        await api("settings", "PUT", {
          marquee: $("#sMarq").value,
          heroTitle: $("#sTitle").value,
          heroSub: $("#sSub").value,
          shipping: +$("#sShip").value || 0,
          hero: admHero,
          reviews: admRev
        });
        toast("تم تحديث إعدادات الموقع بنجاح ✓");
        loadAll();
      }catch(e){ toast("حدث خطأ أثناء الحفظ"); }
    };
  }
}

/* نافذة إضافة وتعديل منتج (تغيير الاسم والصور والسعر بالكامل) */
let modalImgs = [];
function openProductModal(id = null){
  const p = id ? products.find(x => x.id === id) : null;
  modalImgs = p ? [...(p.images || [])] : [];
  const s = $("#sheet");
  s.innerHTML = `
    <div class="grab"></div>
    <div class="sec-h"><span>${p ? "تعديل المنتج" : "إضافة منتج جديد"}</span><button onclick="closeSheet()" style="color:var(--mute)">إغلاق ✕</button></div>
    <label>اسم المنتج</label>
    <div class="fi"><input id="mName" value="${esc(p?.name || "")}" placeholder="مثال: تريند كذا / بيجامة..."></div>
    <div class="grid-2">
      <div><label>السعر الحالي (جنيه)</label><div class="fi"><input id="mPrice" type="number" value="${p?.price || ""}"></div></div>
      <div><label>السعر قبل الخصم</label><div class="fi"><input id="mOld" type="number" value="${p?.oldPrice || ""}"></div></div>
    </div>
    <div class="grid-2">
      <div><label>المقاسات (افصل بفاصلة ,)</label><div class="fi"><input id="mSizes" value="${esc((p?.sizes||[]).join(", "))}" placeholder="S, M, L, XL"></div></div>
      <div><label>الكمية في المخزون</label><div class="fi"><input id="mStock" type="number" value="${p ? p.stock : 15}"></div></div>
    </div>
    <label>وصف المنتج</label>
    <div class="fi"><textarea id="mDesc" rows="2" placeholder="تفاصيل الخامة والمقاس...">${esc(p?.desc || "")}</textarea></div>
    <label>صور المنتج (ارفع من جهازك أو ضع رابط)</label>
    <div class="fi"><input id="mUrl" placeholder="رابط صورة مباشر https://..."><button type="button" class="ico" id="mUrlAdd">${ic("plus")}</button></div>
    <label class="file-btn">${ic("img")} اختيار صور من الهاتف<input type="file" id="mFile" accept="image/*" multiple hidden></label>
    <div class="imgs" id="mImgsBox"></div>
    <button class="btn p" id="mSaveBtn">${p ? "حفظ التعديلات" : "نشر المنتج في المتجر"}</button>
  `;
  $("#ov").classList.add("show");
  requestAnimationFrame(() => s.classList.add("show"));
  document.body.classList.add("lock");

  const drawModalImgs = () => {
    $("#mImgsBox").innerHTML = modalImgs.map((u,i) => `<div class="img-item"><img src="${esc(u)}"><button type="button" onclick="rmModalImg(${i})">✕</button></div>`).join("");
  };
  window.rmModalImg = i => { modalImgs.splice(i,1); drawModalImgs(); };
  drawModalImgs();

  $("#mUrlAdd").onclick = () => {
    const v = $("#mUrl").value.trim();
    if(v){ modalImgs.push(v); $("#mUrl").value = ""; drawModalImgs(); }
  };
  $("#mFile").onchange = async e => {
    for(const f of e.target.files) modalImgs.push(await resize(f));
    drawModalImgs();
  };
  $("#mSaveBtn").onclick = async () => {
    const name = $("#mName").value.trim();
    const price = +$("#mPrice").value;
    if(!name || !price) return toast("اكتب اسم المنتج والسعر");
    const data = {
      name,
      price,
      oldPrice: +$("#mOld").value || 0,
      sizes: $("#mSizes").value.split(",").map(x=>x.trim()).filter(Boolean),
      sizeLabel: "المقاس",
      stock: +$("#mStock").value || 0,
      desc: $("#mDesc").value.trim(),
      images: modalImgs,
      updatedAt: Date.now()
    };
    try{
      if(p) await api(`products/${p.id}`, "PATCH", data);
      else await api("products", "POST", {...data, createdAt: Date.now()});
      toast(p ? "تم تعديل المنتج بنجاح ✓" : "تمت إضافة المنتج ✓");
      closeSheet();
      loadAll();
    }catch(e){ toast("فشل الحفظ، راجع قواعد Firebase"); }
  };
}

async function delProduct(id){
  if(!confirm("متأكد من حذف المنتج نهائياً؟")) return;
  await api(`products/${id}`, "DELETE");
  toast("تم الحذف");
  loadAll();
}
async function delOrder(id){
  if(!confirm("حذف هذا الطلب؟")) return;
  await api(`orders/${id}`, "DELETE");
  toast("تم حذف الطلب");
  loadAll();
}
function closeSheet(){
  $("#sheet").classList.remove("show");
  $("#ov").classList.remove("show");
  document.body.classList.remove("lock");
}
$("#ov").onclick = closeSheet;

checkAuth();
</script>
</body>
</html>
